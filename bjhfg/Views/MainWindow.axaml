<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WeatherAppAvalonia.Views.MainWindow"
        Title="🌤️ Погода - Avalonia"
        Width="500" Height="600"
        Background="#E6F2FF">
    
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20">
        <!-- Заголовок -->
        <TextBlock Text="🌡️ Прогноз погоды" 
                   FontSize="24" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- Строка поиска -->
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
            <TextBlock Text="🏙️ Город:" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Grid.Column="0"/>
            
            <TextBox x:Name="CityInput"
                     Watermark="Например: Moscow"
                     Grid.Column="1"
                     Margin="0,0,10,0"/>
            
            <Button x:Name="SearchButton"
                    Content="🔍 Найти"
                    Grid.Column="2"
                    Background="#2196F3"
                    Foreground="White"/>
        </Grid>

        <!-- Иконка погоды -->
        <Image x:Name="WeatherImage"
               Width="120" 
               Height="120"
               HorizontalAlignment="Center"
               Margin="0,20"/>

        <!-- Город -->
        <TextBlock x:Name="CityText"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,5"/>

        <!-- Температура -->
        <TextBlock x:Name="TempText"
                   FontSize="48"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#FF5722"/>

        <!-- Состояние погоды -->
        <TextBlock x:Name="ConditionText"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Влажность -->
        <TextBlock x:Name="HumidityText"
                   FontSize="14"
                   HorizontalAlignment="Center"/>

        <!-- Ветер -->
        <TextBlock x:Name="WindText"
                   FontSize="14"
                   HorizontalAlignment="Center"/>
        
        <!-- Статус загрузки -->
        <TextBlock x:Name="LoadingText"
                   Text="⏳ Загрузка..."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   IsVisible="False"/>
    </StackPanel>
</Window>
